local fs = require "lib.fs"

local M = {}

function M.parse(argv)
    local o = { pos = {} }
    local i = 1
    while i <= #argv do
        local a = argv[i]
        if a == "-np" then
            o.new    = argv[i + 1] or ""
            o.vscode = tonumber(argv[i + 2] or "0") ~= 0
            o.lsp    = tonumber(argv[i + 3] or "0") ~= 0
            i = i + 3
        elseif a:sub(1, 2) == "--" then
            local key = a:sub(3):gsub("%-", "_")
            local eq  = key:find("=", 1, true)
            if eq then
                o[key:sub(1, eq - 1)] = key:sub(eq + 1)
            else
                local nx = argv[i + 1]
                if nx and nx:sub(1, 1) ~= "-" then
                    o[key] = nx
                    i = i + 1
                else
                    o[key] = true
                end
            end
        elseif a:sub(1, 1) == "-" and a ~= "-" then
            for j = 2, #a do o[a:sub(j, j)] = true end
        else
            o.pos[#o.pos + 1] = a
        end
        i = i + 1
    end

    if type(o.new) == "string" then o.new = fs.norm(o.new) end
    if type(o.dir) == "string" then o.dir = fs.norm(o.dir) end

    for _, k in ipairs({ "dir", "src", "out", "exe_name", "lua_version", "lsp_dir" }) do
        if o[k] == true then
            print("\27[33m  ! --" .. k:gsub("_", "-") .. " без значения — игнорируется\27[0m")
            o[k] = nil
        end
    end

    return o
end

return M